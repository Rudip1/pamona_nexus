# ── colcon build outputs ──────────────────────────────────────────────────────
build/
install/
log/

# ── python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── ROS / Gazebo runtime artifacts ────────────────────────────────────────────
*.bag
*.db3
*.mcap

# ── screen recordings (too heavy for git; commit a trimmed .gif instead) ──────
*.webm
*.mp4
*.mov

# ── goldmines: reference-only, NOT version controlled ────────────────────────
# Read-only ROS1 source + robot dumps + downloaded sim assets (~4 GB).
# Keep locally for reference; never commit the whole folder.
goldmines/

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── AI assistant / local tooling (keep out of the repo) ──────────────────────
.claude/
plans/
*.plan.md
AGENTS.md
CLAUDE.md

# Personal job-application materials (CV, cover letter, drafts) — not part of the project
apply/
