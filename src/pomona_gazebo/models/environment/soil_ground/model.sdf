<?xml version="1.0"?>
<!-- Soil floor: textured 26x26 m plane (replaces the default grey ground_plane).
     Visual = soil-textured mesh; collision = flat plane the robot drives on. -->
<sdf version="1.6">
  <model name="soil_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>26 26</size></plane>
        </geometry>
        <surface>
          <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh><uri>model://soil_ground/meshes/ground.obj</uri></mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
