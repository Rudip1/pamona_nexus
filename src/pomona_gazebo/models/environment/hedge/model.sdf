<?xml version="1.0"?>
<!-- Hedge wall: foliage box 30 x 0.4 x 1.2 m, base on ground (Z-up mesh).
     Mesh source is 28 m long, scaled 30/28 along its length to match. -->
<sdf version="1.6">
  <model name="hedge">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry><mesh><uri>model://hedge/meshes/hedge.obj</uri><scale>1.07143 1 1</scale></mesh></geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0.6 0 0 0</pose>
        <geometry><box><size>30 0.4 1.2</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
