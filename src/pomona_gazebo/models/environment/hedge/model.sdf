<?xml version="1.0"?>
<!-- Hedge wall: foliage box 28 x 0.4 x 1.2 m, base on ground (Z-up mesh). -->
<sdf version="1.6">
  <model name="hedge">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry><mesh><uri>model://hedge/meshes/hedge.obj</uri></mesh></geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0.6 0 0 0</pose>
        <geometry><box><size>28 0.4 1.2</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
