<?xml version="1.0"?>
<!-- Raised mulch bed (mesh): crowned trapezoid, plastic wraps top+sides+ends,
     chamfered edges. 10 m long x 1 m wide x ~0.54 m tall. Mesh exports Y-up;
     the visual pose rolls it upright (Z-up). Holes added later at plant spots. -->
<sdf version="1.6">
  <model name="bed">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><mesh><uri>model://bed/meshes/bed.obj</uri></mesh></geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0.25 0 0 0</pose>
        <geometry><box><size>10 1.0 0.5</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>
