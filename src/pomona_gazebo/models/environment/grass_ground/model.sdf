<?xml version="1.0"?>
<!-- Grass floor: textured 30x30 m plane. Sits just below the 26x26 soil so the
     outer ~2 m ring shows as grass around the soil (reaches under the hedge
     wall at +/-15 m). Mesh source is 28x28, scaled 30/28 to match. -->
<sdf version="1.6">
  <model name="grass_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://grass_ground/meshes/ground.obj</uri><scale>1.07143 1.07143 1</scale></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
