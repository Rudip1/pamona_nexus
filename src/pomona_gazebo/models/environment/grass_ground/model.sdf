<?xml version="1.0"?>
<!-- Grass floor: textured 28x28 m plane. Sits just below the 26x26 soil so the
     outer ~1 m ring shows as grass around the soil. -->
<sdf version="1.6">
  <model name="grass_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>28 28</size></plane></geometry>
        <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><mesh><uri>model://grass_ground/meshes/ground.obj</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
