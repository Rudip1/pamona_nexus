<?xml version="1.0"?>
<!-- Side-by-side check of all strawberry plant variants in Gazebo Classic.
     Run:  gazebo ~/pomona_nexus/cad_agent/strawberry_plants/check_all_variants.world
     Plants are spaced 0.7 m apart along +X, each with the X->Y->Z fix rotation. -->
<sdf version="1.6">
  <world name="check_all_variants">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ripe -->
    <model name="ripe"><static>true</static><pose>0.0 0 0 1.5708 0 1.5708</pose>
      <link name="link"><visual name="v"><geometry><mesh>
        <uri>file:///home/pravin/pomona_nexus/cad_assets_studio/strawberry/variants/strawberry_ripe.obj</uri>
      </mesh></geometry></visual></link></model>

    <!-- half-ripe -->
    <model name="halfripe"><static>true</static><pose>0.7 0 0 1.5708 0 1.5708</pose>
      <link name="link"><visual name="v"><geometry><mesh>
        <uri>file:///home/pravin/pomona_nexus/cad_assets_studio/strawberry/variants/strawberry_halfripe.obj</uri>
      </mesh></geometry></visual></link></model>

    <!-- unripe -->
    <model name="unripe"><static>true</static><pose>1.4 0 0 1.5708 0 1.5708</pose>
      <link name="link"><visual name="v"><geometry><mesh>
        <uri>file:///home/pravin/pomona_nexus/cad_assets_studio/strawberry/variants/strawberry_unripe.obj</uri>
      </mesh></geometry></visual></link></model>

    <!-- flowering (approx; pending real flower geometry) -->
    <model name="flower"><static>true</static><pose>2.1 0 0 1.5708 0 1.5708</pose>
      <link name="link"><visual name="v"><geometry><mesh>
        <uri>file:///home/pravin/pomona_nexus/cad_assets_studio/strawberry/variants/strawberry_flower.obj</uri>
      </mesh></geometry></visual></link></model>

    <!-- diseased: powdery mildew (white) -->
    <model name="mildew"><static>true</static><pose>2.8 0 0 1.5708 0 1.5708</pose>
      <link name="link"><visual name="v"><geometry><mesh>
        <uri>file:///home/pravin/pomona_nexus/cad_assets_studio/strawberry/variants/strawberry_mildew.obj</uri>
      </mesh></geometry></visual></link></model>

    <!-- diseased: leaf scorch (yellow + dark spots) -->
    <model name="leafscorch"><static>true</static><pose>3.5 0 0 1.5708 0 1.5708</pose>
      <link name="link"><visual name="v"><geometry><mesh>
        <uri>file:///home/pravin/pomona_nexus/cad_assets_studio/strawberry/variants/strawberry_leafscorch.obj</uri>
      </mesh></geometry></visual></link></model>

    <gui>
      <camera name="user_camera">
        <pose>1.75 -2.4 1.0 0 0.25 1.5708</pose>
      </camera>
    </gui>
  </world>
</sdf>
