<?xml version="1.0"?>
<!-- Throwaway world to eyeball one textured strawberry plant in Gazebo Classic.
     Run:  gazebo ~/pomona_nexus/cad_agent/strawberry_plants/check_plant.world -->
<sdf version="1.6">
  <world name="check_plant">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <model name="strawberry_plant_01">
      <static>true</static>
      <!-- axis swap X->Y, Y->Z, Z->X  (Rz(90)*Rx(90)) -->
      <pose>0 0 0 1.5708 0 1.5708</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file:///home/pravin/pomona_nexus/cad_assets_studio/strawberry/meshes/strawberry_plant_01.obj</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <gui>
      <camera name="user_camera">
        <pose>0.8 -0.8 0.5 0 0.35 2.4</pose>
      </camera>
    </gui>
  </world>
</sdf>
